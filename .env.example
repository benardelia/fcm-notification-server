SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Firebase
FIREBASE_CREDENTIALS_PATH=fcm_keys/your-firebase-credentials.json

# Database — PostgreSQL (recommended) or SQLite for development
DATABASE_URL=postgres://user:password@localhost:5432/notification
# DATABASE_URL=sqlite:///db.sqlite3

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS — comma-separated list of allowed origins (browser clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Sentry — leave blank to disable error tracking
SENTRY_DSN=
